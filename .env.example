# Deepgram key for voice-note transcription. https://console.deepgram.com
DEEPGRAM_API_KEY=
# OpenRouter key. Text triage uses the free router at openrouter/free.
OPENROUTER_API_KEY=
# Google AI Studio key for photo triage, and for text if OpenRouter fails. Leave blank to skip Gemini.
GEMINI_API_KEY=
NEXT_PUBLIC_EMERGENCY_NUMBER=999
