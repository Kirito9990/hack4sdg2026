# Optional external providers; also require account AI-processing consent.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# auto detects the dominant language; use zh-HK for a Cantonese-only demo.
DEEPGRAM_LANGUAGE=auto
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
NEXT_PUBLIC_EMERGENCY_NUMBER=999
# Local volunteer-to-resident test destination. Leave blank for the real number.
CARECALL_TEST_CALL_PHONE=
# Canonical HTTPS origin behind a production reverse proxy. Blank for local use.
CARECALL_PUBLIC_ORIGIN=
